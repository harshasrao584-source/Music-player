{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets/|api/|uploads/|favicon.ico|logo.jpg).*)",
      "destination": "/index.html"
    }
  ]
}
