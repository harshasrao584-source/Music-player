{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
